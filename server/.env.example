NODE_ENV=development
PORT=3000
DATA_DIR=./data
JWT_SECRET=cambie-esta-clave-por-una-de-al-menos-32-caracteres
JWT_DAYS=7
# Correos separados por coma con rol de superadministrador (pueden invitar y administrar consultorios)
SUPERADMIN_EMAILS=admin@ejemplo.com
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_GMAIL_CALLBACK_URL=http://localhost:3000/api/auth/google/gmail/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portal Clínico <no-reply@example.com>"
REMINDER_CRON=0 * * * *
REMINDER_HOURS=24
# Copias de seguridad locales (WAL-safe) dentro de data/backups; la copia externa usa Restic→S3 vía Dokploy
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_LOCAL=3
